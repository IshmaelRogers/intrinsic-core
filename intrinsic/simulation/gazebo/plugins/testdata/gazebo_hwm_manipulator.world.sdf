Headless hardware-module fixture for the simulated manipulator path.
The include uri is the in-repo UR5e model. Rendering stays off; the
golden test loads this file with the existing world template and does
not start a simulator process.
-->
<sdf version="1.6">
  <world name="gazebo_hwm_manipulator">
    <plugin
        filename="static://intrinsic::simulation::HardwareModuleLauncher"
        name="intrinsic::simulation::HardwareModuleLauncher"/>
    <model name="ur5e">
      <include>
        <uri>model://intrinsic/robot_definitions/ur/ur5e</uri>
      </include>
    </model>
  </world>
</sdf>
