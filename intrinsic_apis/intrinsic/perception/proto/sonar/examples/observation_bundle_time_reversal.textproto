# FLS receive_time is before source_time. Skew among present slots is zero,
# so the reversal is the defect. STATE_VALID does not repair it.
header {
  sequence: 7
  source_time {
    seconds: 1700000000
  }
  receive_time {
    seconds: 1700000000
    nanos: 100000000
  }
  source_id: "bundle_0"
  frame_id: "sync"
  clock_domain: "monotonic"
  validity {
    state: STATE_VALID
  }
}
max_skew {
  nanos: 200000000
}
fls {
  header {
    sequence: 11
    source_time {
      seconds: 1700000000
      nanos: 100000000
    }
    receive_time {
      seconds: 1700000000
      nanos: 50000000
    }
    source_id: "fls_0"
    frame_id: "fls_sonar"
    clock_domain: "monotonic"
  }
  reference_id: "fls-frame-0001"
  byte_size: 128
}
absent {
  modality: OBSERVATION_MODALITY_SONAR_SSS
  reason: ABSENT_MODALITY_REASON_NOT_CONFIGURED
}
absent {
  modality: OBSERVATION_MODALITY_OPTICAL
  reason: ABSENT_MODALITY_REASON_SENSOR_OFFLINE
}
absent {
  modality: OBSERVATION_MODALITY_POINT_CLOUD
  reason: ABSENT_MODALITY_REASON_OUT_OF_RANGE
}
absent {
  modality: OBSERVATION_MODALITY_VEHICLE_STATE
  reason: ABSENT_MODALITY_REASON_INTENTIONALLY_OMITTED
}
