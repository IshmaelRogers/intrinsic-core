# FLS and SSS disagree by 200ms + 1ns. max_skew is 200ms, so the skew is
# strictly outside the window. STATE_VALID does not repair the defect.
header {
  sequence: 7
  source_time {
    seconds: 1700000000
  }
  receive_time {
    seconds: 1700000000
    nanos: 100000000
  }
  source_id: "bundle_0"
  frame_id: "sync"
  clock_domain: "monotonic"
  validity {
    state: STATE_VALID
  }
}
max_skew {
  nanos: 200000000
}
fls {
  header {
    sequence: 11
    source_time {
      seconds: 1700000000
    }
    receive_time {
      seconds: 1700000000
      nanos: 1000000
    }
    source_id: "fls_0"
    frame_id: "fls_sonar"
    clock_domain: "monotonic"
  }
  reference_id: "fls-frame-0001"
  byte_size: 128
}
sss {
  header {
    sequence: 12
    source_time {
      seconds: 1700000000
      nanos: 200000001
    }
    receive_time {
      seconds: 1700000000
      nanos: 200000001
    }
    source_id: "sss_0"
    frame_id: "sss_sonar"
    clock_domain: "monotonic"
  }
  reference_id: "sss-frame-0001"
  byte_size: 256
}
absent {
  modality: OBSERVATION_MODALITY_OPTICAL
  reason: ABSENT_MODALITY_REASON_NOT_CONFIGURED
}
absent {
  modality: OBSERVATION_MODALITY_POINT_CLOUD
  reason: ABSENT_MODALITY_REASON_NOT_CONFIGURED
}
absent {
  modality: OBSERVATION_MODALITY_VEHICLE_STATE
  reason: ABSENT_MODALITY_REASON_INTENTIONALLY_OMITTED
}
