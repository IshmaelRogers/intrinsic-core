# Camera-only bundle. Optical is present. FLS, SSS, point cloud, and vehicle
# state are absent with approved reasons. Skew is inside the 200ms window.
header {
  sequence: 7
  source_time {
    seconds: 1700000000
  }
  receive_time {
    seconds: 1700000000
    nanos: 100000000
  }
  source_id: "bundle_0"
  frame_id: "sync"
  clock_domain: "monotonic"
  validity {
    state: STATE_VALID
  }
}
max_skew {
  nanos: 200000000
}
optical {
  header {
    sequence: 13
    source_time {
      seconds: 1700000000
      nanos: 50000000
    }
    receive_time {
      seconds: 1700000000
      nanos: 80000000
    }
    source_id: "cam_0"
    frame_id: "optical_cam"
    clock_domain: "monotonic"
