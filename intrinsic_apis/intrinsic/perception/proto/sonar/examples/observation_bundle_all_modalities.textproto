# All modalities present. Measured skew is 180ms, inside the 200ms window.
# world_snapshot_id is 64 lowercase hex. No modality is absent.
header {
  sequence: 7
  source_time {
    seconds: 1700000000
  }
  receive_time {
    seconds: 1700000000
    nanos: 200000000
  }
  source_id: "bundle_0"
  frame_id: "sync"
  clock_domain: "monotonic"
  validity {
    state: STATE_VALID
  }
}
max_skew {
  nanos: 200000000
}
fls {
  header {
    sequence: 11
    source_time {
      seconds: 1700000000
    }
    receive_time {
      seconds: 1700000000
      nanos: 10000000
    }
    source_id: "fls_0"
    frame_id: "fls_sonar"
    clock_domain: "monotonic"
  }
  reference_id: "fls-frame-0001"
  byte_size: 128
}
sss {
  header {
    sequence: 12
    source_time {
      seconds: 1700000000
      nanos: 50000000
    }
    receive_time {
      seconds: 1700000000
      nanos: 60000000
    }
    source_id: "sss_0"
    frame_id: "sss_sonar"
    clock_domain: "monotonic"
  }
  reference_id: "sss-frame-0001"
  byte_size: 256
}
optical {
  header {
    sequence: 13
    source_time {
      seconds: 1700000000
      nanos: 100000000
    }
    receive_time {
      seconds: 1700000000
      nanos: 110000000
    }
    source_id: "cam_0"
    frame_id: "optical_cam"
    clock_domain: "monotonic"
  }
  reference_id: "optical-frame-0001"
