# Nominal vendor INS solution. rx, ry, rz are placeholder attitude variances.
# Diagonal slots are px, py, pz, rx, ry, rz. Every other entry is 0.
health {
  header {
    sequence: 42
    source_time {
      seconds: 1700000000
      nanos: 250000000
    }
    receive_time {
      seconds: 1700000001
    }
    source_id: "nav_sensor"
    frame_id: "ins"
    clock_domain: "monotonic"
    validity {
      state: STATE_VALID
    }
  }
  state: VALID
  quality: 0.75
  covariance {
    values: 1
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 4
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.25
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.0625
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.125
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.5
  }
  sources {
    source_id: "primary"
    validity {
      state: STATE_VALID
    }
  }
  sources {
    source_id: "aiding"
  }
}
position_x_m: 12
position_y_m: -4
position_z_m: 0.5
orientation_xyzw {
  x: 0
  y: 0
  z: 0
  w: 1
}
linear_velocity_x_m_s: 1.5
linear_velocity_y_m_s: 0
linear_velocity_z_m_s: -0.25
angular_velocity_x_rad_s: 0
angular_velocity_y_rad_s: 0.125
angular_velocity_z_rad_s: 0
source: SOURCE_VENDOR_INS
