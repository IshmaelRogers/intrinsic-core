# Nominal bottom-track DVL. Angular variance slots are zero.
health {
  header {
    sequence: 42
    source_time {
      seconds: 1700000000
      nanos: 250000000
    }
    receive_time {
      seconds: 1700000001
    }
    source_id: "nav_sensor"
    frame_id: "sensor"
    clock_domain: "monotonic"
    validity {
      state: STATE_VALID
    }
  }
  state: VALID
  quality: 0.75
  covariance {
    values: 0.25
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.25
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.25
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
  }
  sources {
    source_id: "primary"
    validity {
      state: STATE_VALID
    }
  }
  sources {
    source_id: "aiding"
  }
}
mode: MODE_BOTTOM_TRACK
velocity_x_m_s: 0.5
velocity_y_m_s: -0.25
velocity_z_m_s: 0
bottom_lock: true
altitude_m: 10
