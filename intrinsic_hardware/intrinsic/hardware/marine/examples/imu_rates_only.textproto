# Nominal raw IMU sample. Orientation is absent, not a zero quaternion.
# Diagonal slots are wx, wy, wz, ax, ay, az. Every other entry is 0.
health {
  header {
    sequence: 42
    source_time {
      seconds: 1700000000
      nanos: 250000000
    }
    receive_time {
      seconds: 1700000001
    }
    source_id: "nav_sensor"
    frame_id: "imu"
    clock_domain: "monotonic"
    validity {
      state: STATE_VALID
    }
  }
  state: VALID
  quality: 0.75
  covariance {
    values: 0.25
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.5
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.125
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 1
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 2
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 4
  }
  sources {
    source_id: "primary"
    validity {
      state: STATE_VALID
    }
  }
  sources {
    source_id: "aiding"
  }
}
angular_velocity_x_rad_s: 0.25
angular_velocity_y_rad_s: -0.5
angular_velocity_z_rad_s: 0.125
linear_acceleration_x_m_s2: 0
linear_acceleration_y_m_s2: 0
linear_acceleration_z_m_s2: 8
