# Nominal pressure plus depth derived from pressure. Off-slot covariance is 0.
health {
  header {
    sequence: 42
    source_time {
      seconds: 1700000000
      nanos: 250000000
    }
    receive_time {
      seconds: 1700000001
    }
    source_id: "nav_sensor"
    frame_id: "sensor"
    clock_domain: "monotonic"
    validity {
      state: STATE_VALID
    }
  }
  state: VALID
  quality: 0.75
  covariance {
    values: 1
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0.25
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
    values: 0
  }
  sources {
    source_id: "primary"
    validity {
      state: STATE_VALID
    }
  }
  sources {
    source_id: "aiding"
  }
}
pressure_pa: 200000
depth_m: 10
depth_provenance: DEPTH_PROVENANCE_FROM_PRESSURE
fluid_density_kg_m3: 1025
