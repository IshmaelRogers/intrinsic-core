  sources {
    source_id: "primary"
    validity {
      state: STATE_VALID
    }
  }
  sources {
    source_id: "aiding"
  }
}
range_m: 10
beam_id: "down"
min_range_m: 0.5
max_range_m: 100
has_return: true
