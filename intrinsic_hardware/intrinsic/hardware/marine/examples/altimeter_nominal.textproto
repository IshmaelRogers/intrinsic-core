    sequence: 42
    source_time {
      seconds: 1700000000
      nanos: 250000000
    }
    receive_time {
      seconds: 1700000001
    }
    source_id: "nav_sensor"
    frame_id: "sensor"
    clock_domain: "monotonic"
    validity {
      state: STATE_VALID
    }
  }
  state: VALID
  quality: 0.75
  covariance {
    values: 0.25
    values: 0
